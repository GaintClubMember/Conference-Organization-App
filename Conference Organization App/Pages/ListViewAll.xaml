<Page x:Class="Conference_Organization_App.Pages.ListViewAll"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Conference_Organization_App.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ListViewAll">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox x:Name="findByTextBox" HorizontalAlignment="Center" Margin="0,0,450,0" Width="270" VerticalAlignment="Center"></TextBox>
            <ComboBox x:Name="findByComboBox" HorizontalAlignment="Center" Margin="0,0,-80,0" VerticalAlignment="Center"></ComboBox>
            <DatePicker x:Name="datePicker" Width="160" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,-500,0"></DatePicker>

        </Grid>

        <ListView Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="eventImage" Grid.Column="0"></Image>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="eventNameLabel" Grid.Row="0" Text="{Binding EventNames.Name}"></TextBlock>
                            <TextBlock x:Name="eventDirectionLabel" Grid.Row="1" Text="{Binding UserEventDirections.name}"></TextBlock>
                            <TextBlock x:Name="eventDateLabel" Grid.Row="2" Text="{Binding EventsMain.Date}"></TextBlock>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Grid Grid.Row="2">
            <Button x:Name="backBtn" 
     Grid.Row="1" 
     Click="backBtn_Click" 
     Content="Назад" 
     HorizontalAlignment="Left" 
        VerticalAlignment="Bottom"
    Height="40"
     Width="170">
            </Button>
            <Button x:Name="regBtn"
     Grid.Row="1" 
     Click="regBtn_Click" 
     Content="Назад" 
     HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Height="40"
     Width="170">
            </Button>
        </Grid>
        
    </Grid>
</Page>
