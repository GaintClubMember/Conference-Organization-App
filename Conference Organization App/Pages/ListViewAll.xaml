<Page x:Class="Conference_Organization_App.Pages.ListViewAll"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Conference_Organization_App.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ListViewAll">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox x:Name="findByTextBox" 
                     HorizontalAlignment="Center" 
                     Margin="0,0,450,0" 
                     Width="270" 
                     VerticalAlignment="Center"></TextBox>
            <ComboBox x:Name="findByComboBox" 
                      HorizontalAlignment="Center" 
                      Margin="0,0,-80,0" 
                      VerticalAlignment="Center" 
                      DisplayMemberPath="name" 
                      SelectedValuePath="id"></ComboBox>
            <DatePicker x:Name="datePicker" 
                        Width="160" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,-500,0"></DatePicker>

        </Grid>

        <ListView Grid.Row="1" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Top" 
                  x:Name="listView"
                  Width="800">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" 
                               Margin="10" 
                               x:Name="eventImage" 
                               Width="100" 
                               Height="80">
                            <Image.Source>
                                <Binding Path="Photo_Image">
                                    <Binding.TargetNullValue>
                                        <BitmapImage UriSource="/Resources/Images/DefaultImage.png"></BitmapImage>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="eventNameLabel" 
                                       Grid.Row="0" 
                                       Text="{Binding EventNames.Name}" 
                                       TextWrapping="Wrap"></TextBlock>
                            <TextBlock x:Name="eventDirectionLabel" 
                                       Grid.Row="1" 
                                       Text="{Binding UserEventDirections.name}" 
                                       TextWrapping="Wrap"></TextBlock>
                            <TextBlock x:Name="eventDateLabel" 
                                       Grid.Row="2" 
                                       Text="{Binding EventsMain.Date}"></TextBlock>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Grid Grid.Row="2">
            <Button x:Name="backBtn" 
                Grid.Row="1" 
                Content="Назад" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom"
                Height="40"
                Width="170">
            </Button>

            <Button x:Name="authBtn"
                Grid.Row="1" 
                Content="Войти" 
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Height="40"
                Width="170">
            </Button>

            <Button x:Name="regBtn"
                 Grid.Row="1" 
                 Content="Назад" 
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Height="40"
                 Width="170">
            </Button>
        </Grid>
        
    </Grid>
</Page>
